<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Unity does not use implicit global usings, so neither does this project. Without this,
         a file missing "using System;" compiles here and fails only in the Unity editor - which
         defeats the purpose of dotnet test being the fast compile check. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.3.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Simulation/**/*.cs" />
    <!-- The one presentation file with no Unity types in it. The free camera's arithmetic - flight
         speed, height bounds, pitch limit - was put there on purpose so it could be checked here
         rather than by a person flying around in Play mode, which is how every previous camera bug
         was found. Everything else under Presentation stays out of this project. -->
    <Compile Include="../../Assets/Scripts/Presentation/FreeCameraMotion.cs" />
    <Compile Include="../../Assets/Scripts/Presentation/PlanetChunkLod.cs" />
    <Compile Include="../../Assets/Scripts/Presentation/CreatureAppearance.cs" />
    <Compile Include="../../Assets/Scripts/Presentation/FrameTimeLog.cs" />
    <Compile Include="../../Assets/Scripts/Presentation/PerformanceSections.cs" />
    <Compile Include="../../Assets/Scripts/Presentation/CreatureAppearanceRules.cs" />
    <Compile Include="../../Assets/Scripts/Presentation/CreatureModelRules.cs" />
    <Compile Include="../../Assets/Scripts/Presentation/CreatureModelCatalog.cs" />
    <Compile Include="../../Assets/Scripts/Presentation/CreaturePicking.cs" />
    <Compile Include="../../Assets/Tests/EditMode/**/*.cs" />
    <Compile Include="GlobalUsings.cs" />
  </ItemGroup>

</Project>
